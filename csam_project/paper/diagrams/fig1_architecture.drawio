        <mxCell id="forget" value="⚡ Forgetting Engine (CA-Ours)&#xa;F(m) = 0.25R + 0.25(1-I) + 0.25C + 0.25D&#xa;Gate: evict only if C(m) ≥ 0.3&#xa;Result: FFR = 0.000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=10;" vertex="1" parent="1">
